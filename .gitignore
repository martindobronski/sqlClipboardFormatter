# Build-Output
target/
out/
build/
*.class
*.jar

# Mitgelieferte Laufzeit aus dem Release-ZIP. Das sind rund 180 MB
# Binaerdateien, die je nach Plattform verschieden sind - sie gehoeren
# nicht in die Historie, sondern in das Release-Asset. start.bat und
# start.sh finden sie, wenn sie da ist, und laufen ohne sie weiter.
jre/

# IntelliJ: Modul- und Artifact-Dateien werden beim Maven-Import erzeugt.
# Wichtig: .idea/ selbst darf NICHT als Verzeichnis ausgeschlossen werden,
# sonst greifen die Ausnahmen unten nicht - Git steigt in ausgeschlossene
# Verzeichnisse nicht ab, eine neue Datei in .idea/artifacts/ waere sonst ignoriert.
*.iml
.idea/modules.xml
.idea/artifacts/
.idea/workspace.xml
.idea/vcs.xml
.idea/shelf/
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/sonarlint/
.idea/inspectionProfiles/

# Geteilte IDE-Konfiguration bleibt versioniert
!.idea/.gitignore
!.idea/misc.xml

.DS_Store
